{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra offline snapshot",
  "$defs": {
    "human": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "offline-fixture"
        },
        "actor": {
          "const": "trundle"
        },
        "decision": {
          "const": "yes"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "mode",
        "actor",
        "decision",
        "action",
        "subject",
        "timestamp",
        "reason"
      ],
      "additionalProperties": true
    },
    "receipt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "offline-fixture"
        },
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "clip_id": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "lineage": {
          "type": "string",
          "minLength": 1
        },
        "media_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "completed": {
          "const": true
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "mode",
        "authority_id",
        "clip_id",
        "slot",
        "lineage",
        "media_hash",
        "timestamp",
        "completed",
        "signature"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "big_changes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "state_so_far": {
          "type": "string",
          "minLength": 1
        },
        "cast": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "held_still": {
          "const": false
        },
        "end_mode": {
          "enum": [
            "free",
            "pinned"
          ]
        },
        "pin_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "corner_tag": {
          "type": "string",
          "minLength": 1
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "depth",
        "big_changes",
        "state_so_far",
        "cast",
        "held_still",
        "end_mode",
        "corner_tag"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "end_mode": {
                "const": "pinned"
              }
            }
          },
          "then": {
            "properties": {
              "pin_reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "pin_reason"
            ]
          }
        }
      ]
    },
    "proposal": {
      "type": "object",
      "properties": {
        "character_id": {
          "type": "string",
          "minLength": 1
        },
        "base_version": {
          "type": "integer",
          "minimum": 1
        },
        "patch": {
          "type": "object",
          "properties": {
            "health": {},
            "mood": {},
            "gear": {},
            "relationships": {}
          },
          "additionalProperties": false
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attestation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "character_id",
        "base_version",
        "patch",
        "ref",
        "attestation",
        "evidence"
      ],
      "additionalProperties": false
    },
    "reuse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "evidence",
        "ref"
      ],
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "logical_id": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "lineage": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "spec": {
          "type": "object"
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "episode": {
          "type": "integer",
          "minimum": 1
        },
        "season": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "segment",
            "ad",
            "house_ad",
            "id"
          ]
        },
        "price_cents": {
          "type": "integer",
          "minimum": 0
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "planned",
            "queued",
            "rendered",
            "approved",
            "aired",
            "pulled",
            "failed",
            "held",
            "rejected"
          ]
        },
        "prompt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "filter_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "invalidated_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal"
          }
        },
        "consequences": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reuse"
          }
        },
        "observations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/observation"
          }
        },
        "media_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "air_permission": {
          "anyOf": [
            {
              "$ref": "#/$defs/human"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "authority_id",
        "version",
        "logical_id",
        "slot",
        "lineage",
        "prompt",
        "prompt_hash",
        "reference_hashes",
        "spec",
        "channel",
        "episode",
        "season",
        "kind",
        "price_cents",
        "route",
        "state",
        "prompt_ids",
        "filter_versions",
        "dependencies",
        "invalidated_by",
        "proposals",
        "consequences",
        "reuses",
        "observations",
        "media_hash",
        "manifest",
        "air_permission"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "queued",
                  "rendered",
                  "approved",
                  "aired"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/spec"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "rendered",
                  "approved",
                  "aired"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "media_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "manifest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "approved",
                  "aired"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "air_permission": {
                "$ref": "#/$defs/human"
              }
            }
          }
        }
      ],
      "x-legal-transitions": {
        "planned": [
          "failed",
          "held",
          "pulled",
          "queued",
          "rejected"
        ],
        "queued": [
          "failed",
          "held",
          "pulled",
          "rejected",
          "rendered"
        ],
        "rendered": [
          "approved",
          "failed",
          "held",
          "pulled",
          "rejected"
        ],
        "approved": [
          "aired",
          "failed",
          "held",
          "pulled",
          "rejected"
        ],
        "aired": [],
        "pulled": [],
        "held": [],
        "failed": [],
        "rejected": []
      }
    },
    "attempt": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "placed",
            "aired",
            "missed",
            "pulled",
            "failed",
            "held",
            "rejected"
          ]
        },
        "merged_into": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "clip_id",
        "status",
        "merged_into",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "original_text": {
          "type": "string",
          "minLength": 1
        },
        "contributor_id": {
          "type": "string",
          "minLength": 1
        },
        "contributor_metadata": {
          "type": "object"
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "eligible",
            "held",
            "consumed",
            "released"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "final_outcome": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "votes": {
          "type": "integer",
          "minimum": 0
        },
        "subject_matter": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "filter": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "allowed",
            "reason",
            "version"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "version",
        "original_text",
        "contributor_id",
        "contributor_metadata",
        "channel",
        "received_at",
        "status",
        "attempts",
        "final_outcome",
        "votes",
        "subject_matter",
        "skipped"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "state_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "hash",
        "evidence"
      ],
      "additionalProperties": true
    },
    "still": {
      "type": "object",
      "properties": {
        "character_id": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "candidate",
            "accepted",
            "primary",
            "retired"
          ]
        },
        "state_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "character_id",
        "hash",
        "state",
        "state_digest",
        "evidence",
        "version"
      ],
      "additionalProperties": false
    },
    "plastic": {
      "type": "object",
      "properties": {
        "health": {
          "type": "string",
          "minLength": 1
        },
        "mood": {
          "type": "string",
          "minLength": 1
        },
        "gear": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relationships": {
          "type": "object"
        },
        "carried_consequences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "health",
        "mood",
        "gear",
        "relationships",
        "carried_consequences"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "locked": {
          "type": "object",
          "properties": {
            "silhouette": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": "string",
              "minLength": 1
            },
            "signature_prop": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "silhouette",
            "color",
            "signature_prop"
          ],
          "additionalProperties": false
        },
        "plastic": {
          "$ref": "#/$defs/plastic"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "abilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summon_count": {
          "type": "integer",
          "minimum": 0
        },
        "writein_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "memory_log": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "field_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "locked",
        "plastic",
        "refs",
        "voice",
        "abilities",
        "summon_count",
        "writein_level",
        "memory_log",
        "field_versions"
      ],
      "additionalProperties": false
    },
    "consequence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "FLASH",
            "SCAR",
            "MARK",
            "LEGEND"
          ]
        },
        "since_index": {
          "type": "integer",
          "minimum": 0
        },
        "episode": {
          "type": "integer",
          "minimum": 1
        },
        "season": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "character_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "text",
        "tier",
        "since_index",
        "episode",
        "season",
        "source",
        "active",
        "version",
        "channel",
        "character_id"
      ],
      "additionalProperties": true
    },
    "clock": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "episode": {
          "type": "integer",
          "minimum": 1
        },
        "season": {
          "type": "integer",
          "minimum": 1
        },
        "away": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "index",
        "episode",
        "season",
        "away"
      ],
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "failure_type": {
          "type": "string",
          "minLength": 1
        },
        "clip_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {},
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "fix_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "version",
        "failure_type",
        "clip_id",
        "evidence",
        "timestamp",
        "fix_id",
        "status",
        "resolution"
      ],
      "additionalProperties": false
    },
    "fix": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "problem_solved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cost_class": {
          "enum": [
            "free ffmpeg",
            "still",
            "full regen"
          ]
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "version",
        "problem_solved",
        "conditions",
        "cost_class",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "appeared_text": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "offline-fixture"
        },
        "media_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "appeared_text",
        "score",
        "evidence",
        "mode",
        "media_hash",
        "prompt_hash"
      ],
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "prompt_id": {
          "type": "string",
